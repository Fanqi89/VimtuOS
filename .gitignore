# VimtuOS / Vimtu64 —— 开源用 .gitignore
#
# 原则：只提交自己写的源码与文档（约 1.7 MB）。
#       打包的第三方工具链、第三方字体、构建产物、验收残留全部排除。
#
# ★★ 踩坑记录：**.gitignore 不支持行尾注释**！
#    写成 `tools/i686-elf/   # 849 MB` 时，整行（含 # 与后面的字）都会被当成
#    一个匹配不到的图案 —— 结果是"看起来排除了，其实一个都没排除"。
#    所以本文件里所有注释都单独占一行。验证方法：git ls-files --others --exclude-standard

# ==================== 第三方工具链（打包进来的，不进仓）====================
# i686-elf 交叉编译器 849 MB：改为在 README 里给下载/构建方式
tools/i686-elf/
# nasm 二进制 2.6 MB：MSYS2 里 pacman -S nasm 即可
tools/nasm/
tools/__pycache__/

# ==================== 字体（第三方的都不进仓）====================
# Fonts/ 是 Windows 字体副本（684 MB，商业字体，**构建已不再使用**，保留只为历史对照）
# ★ 必须写 /Fonts/ 而不是 Fonts/：Windows 上 git 默认忽略大小写，写成 Fonts/ 会连
#   docs/fonts/（License 全文，必须进仓）一起排掉 —— 本次实测踩到的坑。
/Fonts/
# Fonts-open/ 是构建真正使用的开源字体（SIL OFL，约 19 MB 的源文件）：
#   NotoSans-Regular.ttf / NotoSerif-Regular.ttf / NotoSansSC[wght].ttf / OFL-*.txt
# 源字体太大没必要进仓 —— 下载地址与许可见 README 第五节 与 docs/字体许可说明.md
/Fonts-open/

# ==================== 已退役的 32 位工程（770 MB）====================
# 若想公开，建议单独建一个仓库作为"移植参考"
legacy32/


# ==================== 构建产物 ====================

build64/
build/
*.elf
*.o
vimtu64-64.iso
vimtu64-64.img
# 资源中间产物（根目录 _*.py 生成）
build/*.ttf
build/*.bin

# ==================== 验收测试残留与日志 ====================
# 每次验收各 16 MB
target-*.img
*-serial.log
*_serial.log
installed_boot.log

# ==================== 会话 / 编辑器杂项 ====================
.pisession/
.pi/
__pycache__/
*.pyc
.vscode/
.idea/
Thumbs.db
desktop.ini
